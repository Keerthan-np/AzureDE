{
	"name": "df_bronze_to_silver_delta",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_adls_bronze_parquetdynamic",
						"type": "DatasetReference"
					},
					"name": "BronzeParquetSource"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "ls_nimble _broze",
						"type": "LinkedServiceReference"
					},
					"name": "SilverDeltaSink"
				}
			],
			"transformations": [],
			"scriptLines": [
				"parameters{",
				"     df_param_TableName as string ('tbl_client'),",
				"     df_param_SilverTableName as string ('silver_client')",
				"}",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet',",
				"     wildcardPaths:[(concat($df_param_TableName, '/*/*.parquet'))]) ~> BronzeParquetSource",
				"BronzeParquetSource sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: ($df_param_SilverTableName),",
				"     deltaTruncate: true,",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SilverDeltaSink"
			]
		}
	}
}