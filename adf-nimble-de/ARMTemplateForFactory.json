{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-nimble-de"
		},
		"ls_nimble _broze_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_nimble _broze'"
		},
		"ls_nimble_oltp_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_nimble_oltp'"
		},
		"ls_nimble _broze_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stnimblede.dfs.core.windows.net/"
		},
		"ls_nimble_oltp_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-nimble-de.database.windows.net"
		},
		"ls_nimble_oltp_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "nimble"
		},
		"ls_nimble_oltp_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "nimbleadmin"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_dunamic_nimble')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Lookup_OldWatermark",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT LastModifiedDate FROM tbl_watermark WHERE TableName = '@{pipeline().parameters.TableName}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_sql_watermark",
								"type": "DatasetReference",
								"parameters": {}
							}
						}
					},
					{
						"name": "Lookup_NewWatermark",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT MAX(@{pipeline().parameters.WatermarkColumn}) as NewTime FROM @{pipeline().parameters.TableName}",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_sql_source_tables",
								"type": "DatasetReference",
								"parameters": {
									"src_TableName": "@{pipeline().parameters.TableName}"
								}
							}
						}
					},
					{
						"name": "CopyDataActivity",
						"type": "Copy",
						"dependsOn": [
							{
								"activity": "Lookup_OldWatermark",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "Lookup_NewWatermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT * FROM @{pipeline().parameters.TableName}\nWHERE @{pipeline().parameters.WatermarkColumn} > '@{activity('Lookup_OldWatermark').output.firstRow.LastModifiedDate}'\nAND @{pipeline().parameters.WatermarkColumn} <= '@{activity('Lookup_NewWatermark').output.firstRow.NewTime}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"sink": {
								"type": "ParquetSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "ParquetWriteSettings"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "ds_sql_source_tables",
								"type": "DatasetReference",
								"parameters": {
									"src_TableName": "@{pipeline().parameters.TableName}"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_adls_bronze_parquetdynamic",
								"type": "DatasetReference",
								"parameters": {
									"sink_FolderName": "@{pipeline().parameters.TableName}",
									"current_Date": {
										"value": "@utcnow()",
										"type": "Expression"
									}
								}
							}
						]
					},
					{
						"name": "Update_Watermark",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "CopyDataActivity",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "ls_nimble_oltp",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "UPDATE tbl_watermark \nSET LastModifiedDate = '@{activity('Lookup_NewWatermark').output.firstRow.NewTime}' \nWHERE TableName = '@{pipeline().parameters.TableName}'",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"TableName": {
						"type": "string"
					},
					"WatermarkColumn": {
						"type": "string"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-05-21T17:06:26Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_sql_watermark')]",
				"[concat(variables('factoryId'), '/datasets/ds_sql_source_tables')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_bronze_parquetdynamic')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_nimble_oltp')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_dynamic_silver_25may')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "lkp_get_active_tables",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT SourceTableName, SilverTableName FROM tbl_nimblecontrollist",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "ds_sql_source_tables",
								"type": "DatasetReference",
								"parameters": {
									"src_TableName": {
										"value": "tbl_nimblecontrollist",
										"type": "Expression"
									}
								}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "fe_loop_tables",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "lkp_get_active_tables",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('lkp_get_active_tables').output.value",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "df_run_incremental_load",
									"type": "ExecuteDataFlow",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"dataflow": {
											"referenceName": "df_incremental_bronze_to_silver",
											"type": "DataFlowReference",
											"parameters": {
												"p_TableName": {
													"value": "'@{item().SourceTableName}'",
													"type": "Expression"
												},
												"p_SilverTableName": {
													"value": "'@{item().SilverTableName}'",
													"type": "Expression"
												},
												"p_ProcessDate": {
													"value": "'@{utcNow('yyyy-MM-dd')}'",
													"type": "Expression"
												}
											},
											"datasetParameters": {
												"BronzeIncrementalSource": {
													"sink_FolderName": {
														"value": "@item().SilverTableName",
														"type": "Expression"
													},
													"current_Date": "@utcNow('yyyy-MM-dd')"
												},
												"SilverIncrementalDeltaSink": {}
											}
										},
										"staging": {},
										"compute": {
											"coreCount": 8,
											"computeType": "General"
										},
										"traceLevel": "Fine"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-05-25T18:42:21Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_sql_source_tables')]",
				"[concat(variables('factoryId'), '/dataflows/df_incremental_bronze_to_silver')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_master_bronze_ingestion')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
