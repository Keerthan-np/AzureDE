							"activities": [
								{
									"name": "exec_child_ingestion",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "pl_dunamic_nimble",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"TableName": {
												"value": "@{item().SourceTableName}",
												"type": "Expression"
											},
											"WatermarkColumn": {
												"value": "@{item().WatermarkColumn}",
												"type": "Expression"
											}
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-05-25T18:42:21Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_sql_source_tables')]",
				"[concat(variables('factoryId'), '/pipelines/pl_dunamic_nimble')]"
			]
		},
